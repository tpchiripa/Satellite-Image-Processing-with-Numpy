# Copy this file to .env and fill in real values. Never commit a real .env.

# NASA FIRMS API key (free registration).
# Get one at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Optional: without this, code using FIRMSProvider will raise a FIRMSError
# with a clear message (or, in the demo notebook, fall back to a labeled
# illustrative sample).
FIRMS_MAP_KEY=

# PostgreSQL + PostGIS connection string.
# Optional: without this, GeoWatch falls back to InMemoryEventStore
# (no persistence between runs). Matches the credentials in
# docker-compose.yml's `db` service by default.
DATABASE_URL=postgresql://geowatch:geowatch@localhost:5432/geowatch
